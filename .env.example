# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/enterprise_auth_db

# Security & Password Policy
BCRYPT_SALT_ROUNDS=12

# Token Expirations (in minutes/hours/days)
EMAIL_VERIFICATION_TOKEN_EXPIRY_HOURS=24
RESEND_VERIFICATION_COOLDOWN_MINUTES=2

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
SIGNUP_RATE_LIMIT_WINDOW_MS=900000
SIGNUP_RATE_LIMIT_MAX_REQUESTS=10

# CORS
CORS_ORIGIN=*

# Client App URL (for verification links)
CLIENT_URL=http://localhost:3000
